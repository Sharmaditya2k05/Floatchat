# SITE_ADDRESS is set in docker-compose.prod.yml:
#   ":80"            -> plain HTTP on the VM's public IP (default)
#   "floatchat.example.com" -> Caddy obtains a Let's Encrypt certificate automatically
{$SITE_ADDRESS::80} {
	encode gzip

	# Frontend calls /api/...; the backend serves the same routes without the prefix.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
