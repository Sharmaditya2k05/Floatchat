# --- Database ---
# The API uses the read-only role; ingestion uses the admin role.
DATABASE_URL=postgresql://floatchat_ro:floatchat_ro@localhost:5433/floatchat
DATABASE_URL_ADMIN=postgresql://floatchat_admin:floatchat@localhost:5433/floatchat

# --- LLM ---
# Provider: anthropic | openai | grok | ollama | none
# "none" (or a missing API key) falls back to the built-in rule-based NL->SQL
# engine, which handles the core query families offline with no model at all.
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Grok / xAI (OpenAI-compatible). To enable:
#   LLM_PROVIDER=grok   LLM_MODEL=grok-3   XAI_API_KEY=xai-...
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Groq — fast + free, OpenAI-compatible (NOTE: this is Groq, not xAI's Grok;
# Groq keys start with "gsk_"). To enable:
#   LLM_PROVIDER=groq   LLM_MODEL=openai/gpt-oss-120b   GROQ_API_KEY=gsk_...
# (GROQ_API_KEY also falls back to XAI_API_KEY / OPENAI_API_KEY if the key
#  happens to sit there.) List your models: GET https://api.groq.com/openai/v1/models
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI, or any OpenAI-compatible service via OPENAI_BASE_URL:
#   OpenRouter:    LLM_PROVIDER=openai  OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

OLLAMA_BASE_URL=http://localhost:11434

# --- RAG ---
# "tfidf" is a dependency-free lexical index that works fully offline.
# Set to "sentence-transformers" (and pip install sentence-transformers)
# for dense embeddings with all-MiniLM-L6-v2.
EMBED_BACKEND=tfidf
EMBED_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=6

# --- Ingestion (Indian Ocean pilot subset) ---
ARGO_REGION_BBOX=20,120,-40,30
ARGO_PRES_MAX=2000
ARGO_DATE_START=2019-01-01
ARGO_DATE_END=2023-12-31

# --- Safety / limits ---
SQL_STATEMENT_TIMEOUT_MS=5000
MAX_ROWS=500
DEV_MODE=false
