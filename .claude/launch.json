{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "floatchat-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173,
      "env": { "API_PORT": "8001" }
    },
    {
      "name": "floatchat-api",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8001"],
      "port": 8001
    }
  ]
}
